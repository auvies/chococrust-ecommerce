APP_NAME="Choco Crust API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated list of exact frontend origins allowed to call this API.
# Never use a wildcard in staging/production (CLAUDE.md §13).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT access-token signing secret (CLAUDE.md §7). Falls back to APP_KEY
# locally so a fresh clone works with no extra setup, but a distinct,
# randomly generated value is REQUIRED in staging/production - rotating
# the JWT secret should never force rotating APP_KEY (which also drives
# encrypted columns like users.two_factor_secret) and vice versa.
JWT_SECRET=

AUTH_ACCESS_TOKEN_TTL=15
AUTH_REFRESH_TOKEN_TTL=20160

# Frontend (Vercel) and backend (Railway) are expected to live on
# different registrable domains unless custom domains are configured, so
# the auth cookies generally need SameSite=None to be sent cross-site at
# all - set AUTH_COOKIE_SAMESITE=none (and keep AUTH_COOKIE_SECURE=true)
# once the real frontend origin is known. The CSRF double-submit cookie
# (see VerifyCsrfCookie) is the actual cross-site CSRF defense either way.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database provider must remain replaceable (Neon today, any managed
# Postgres tomorrow) - only these env vars change, never application code.
# Neon requires SSL; keep DB_SSLMODE=require against Neon.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chococrust
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Business API - preparation only (CLAUDE.md §6), no account
# exists yet. WHATSAPP_ENABLED must stay false until a real account and
# credentials exist - see App\Notifications\Channels\WhatsAppChannel.
WHATSAPP_ENABLED=false
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=

# Facebook/Instagram - preparation only (CLAUDE.md §6), no Meta developer
# app or Instagram Business account is connected yet. These are never
# exposed to the frontend - see SocialAccountController::status(), which
# only ever reports connected: true/false.
FACEBOOK_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ENABLED=false
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# AI chatbot (Anthropic). Unlike WhatsApp/Facebook above, the chatbot works
# today without this - deterministic answers (price/stock/delivery/hours/
# payment methods/order status/contact) need no API key. Only leave this
# blank in every environment until a real key is provisioned; AiChatService
# falls back to a safe canned message for anything that would otherwise
# need a live model call.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=400
ANTHROPIC_MAX_HISTORY_MESSAGES=8
ANTHROPIC_MAX_CALLS_PER_HOUR=15
# Configurable usage limits (App\Services\Ai\AiUsageLimiter) beyond the
# per-conversation cap above. The two daily caps are 0 (disabled) by
# default - set them once real spend needs a hard ceiling.
ANTHROPIC_MAX_AGENT_TOOL_CALLS_PER_HOUR=30
ANTHROPIC_DAILY_COST_LIMIT_USD=0
ANTHROPIC_DAILY_REQUEST_LIMIT=0
ANTHROPIC_TIMEOUT_SECONDS=15

# Object storage for uploads (CLAUDE.md §12 - never the app server's local
# disk in production; Railway containers are ephemeral, so FILESYSTEM_DISK
# staying "local" in production means every upload is lost on the next
# deploy). Works against real AWS S3 or any S3-compatible provider (e.g.
# Cloudflare R2) - set AWS_ENDPOINT/AWS_URL for a non-AWS provider, leave
# both blank for real AWS S3. See DEPLOYMENT.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_URL=
