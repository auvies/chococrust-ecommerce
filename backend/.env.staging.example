# Staging environment template.
#
# This file documents which values differ from .env.example for staging.
# It is NOT loaded automatically and contains no real secrets - actual
# staging values are set directly in Railway's environment variables for
# the staging service (CLAUDE.md §6, §21), never committed here.

APP_ENV=staging
APP_DEBUG=false
APP_URL=https://api-staging.chococrust.example

CORS_ALLOWED_ORIGINS=https://staging.chococrust.example

# Distinct from production's JWT_SECRET and from APP_KEY - generate with
# `php artisan tinker --execute="echo bin2hex(random_bytes(32));"` or
# equivalent and set directly in Railway's staging service, never here.
JWT_SECRET=

# Frontend and backend are on different registrable domains in this
# topology (Vercel + Railway without custom domains) - SameSite=None is
# required for the auth cookies to be sent cross-site at all.
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Neon staging branch/database. Use a separate Neon project/branch from
# production so staging data and production data never mix.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_DOMAIN=.chococrust.example

MAIL_MAILER=log
