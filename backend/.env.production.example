# Production environment template.
#
# This file documents which values differ from .env.example for production.
# It is NOT loaded automatically and contains no real secrets - actual
# production values are set directly in Railway's environment variables for
# the production service (CLAUDE.md §6, §21), never committed here.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.chococrust.example

CORS_ALLOWED_ORIGINS=https://chococrust.example

# Distinct from staging's JWT_SECRET and from APP_KEY - generate with
# `php artisan tinker --execute="echo bin2hex(random_bytes(32));"` or
# equivalent and set directly in Railway's production service, never here.
# If this value is ever accidentally committed or leaked, treat it as
# compromised and rotate it immediately (CLAUDE.md §6) - every previously
# issued access token becomes invalid the moment it rotates, which is the
# intended blast-radius containment.
JWT_SECRET=

AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Neon production database. A fresh backup is required before any
# destructive migration against this connection (CLAUDE.md §17).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_DOMAIN=.chococrust.example

MAIL_MAILER=log
