# Copy to .env.local for local development. .env.local is gitignored and
# never committed - this file documents what's required (CLAUDE.md §6).
#
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser and is public by
# definition. Never put a real secret behind that prefix.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_ENV=development

# Optional: this app's own public URL, used only for canonical/OG tags and
# the sitemap. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
